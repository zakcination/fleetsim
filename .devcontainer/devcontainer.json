{
  "name": "fleetsim (ROS 2 Jazzy)",
  "build": { "dockerfile": "Dockerfile" },
  "postCreateCommand": "pip install -e '.[dev]' && pytest -q",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter", "ms-iot.vscode-ros"],
      "settings": { "python.defaultInterpreterPath": "/opt/venv/bin/python" }
    }
  }
}
